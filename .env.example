# ============================================================
# Trade Copilot — root-level env reference
# Copy to backend/.env and frontend/.env.local (split as marked).
# Never commit real .env files.
# ============================================================

# -------------------- BACKEND (backend/.env) ----------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_random_64_chars

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_me_fernet_key_32_bytes_b64

# SQLite for local; for prod use a real Postgres URL.
# Local (default):
DATABASE_URL=sqlite:///./trade_copilot.db
# Production (Koyeb + Neon) — example shape (replace creds + region):
# DATABASE_URL=postgresql+psycopg2://USER:PASS@ep-xyz-pooler.us-east-1.aws.neon.tech/trade_copilot?sslmode=require

# TradeLocker API endpoints
TRADELOCKER_API_BASE=https://live.tradelocker.com/backend-api
TRADELOCKER_DEMO_API_BASE=https://demo.tradelocker.com/backend-api

# Optional Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# CORS — comma-separated origins (no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Buy Me a Coffee handle (used by frontend too)
BUY_ME_COFFEE_USERNAME=dbutler

# -------------------- FRONTEND (frontend/.env.local) --------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BMC_USERNAME=dbutler
