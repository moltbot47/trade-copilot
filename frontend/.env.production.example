# Production (Vercel) — set these via `vercel env add` or the dashboard.
# These are baked at build time because Next.js inlines NEXT_PUBLIC_*.

# After Koyeb migration the API lives at the custom domain pointed at
# Koyeb (CNAME -> trade-copilot-api-<org>.koyeb.app). See DEPLOY-KOYEB.md.
NEXT_PUBLIC_API_URL=https://api.trading.jetlag-recovery.com
NEXT_PUBLIC_BMC_USERNAME=dbutler
